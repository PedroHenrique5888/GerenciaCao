<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash_laranja">#FFFFAD31</color>

    <!-- Splash do sistema (Android 12+ e, pela biblioteca, também do 8 ao 11).
         Se o tema do seu app tiver outro nome, ajuste postSplashScreenTheme. -->
    <style name="Theme.GerenciaCao.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_laranja</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icone</item>
        <item name="postSplashScreenTheme">@style/Theme.GerenciaCao</item>
    </style>
</resources>
